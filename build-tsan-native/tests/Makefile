	cd /tmp/x2pc-pr15/build-tsan-native && $(MAKE) $(MAKESILENT) -f tests/CMakeFiles/x86_stack_flags_test.dir/build.make tests/CMakeFiles/x86_stack_flags_test.dir/x86_stack_flags_test.cpp.i
.PHONY : x86_stack_flags_test.cpp.i

x86_stack_flags_test.s: x86_stack_flags_test.cpp.s
.PHONY : x86_stack_flags_test.s

# target to generate assembly for a file
x86_stack_flags_test.cpp.s:
	cd /tmp/x2pc-pr15/build-tsan-native && $(MAKE) $(MAKESILENT) -f tests/CMakeFiles/x86_stack_flags_test.dir/build.make tests/CMakeFiles/x86_stack_flags_test.dir/x86_stack_flags_test.cpp.s
.PHONY : x86_stack_flags_test.cpp.s

